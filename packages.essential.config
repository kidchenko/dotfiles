<?xml version="1.0" encoding="utf-8"?>
<!--
  packages.essential.config - Minimal dev tools for fast Windows bootstrap
  Windows counterpart of Brewfile.essential

  Install: choco install packages.essential.config -y
  Full software list: run `dotfiles packages` after bootstrap
-->
<packages>
  <!-- Core -->
  <package id="git" />
  <package id="gh" />

  <!-- Modern CLI tools -->
  <package id="fzf" />
  <package id="ripgrep" />
  <package id="bat" />
  <package id="jq" />
  <package id="yq" />

  <!-- Dotfiles management -->
  <package id="chezmoi" />

  <!-- Terminal -->
  <package id="microsoft-windows-terminal" />
  <package id="powershell-core" />
  <package id="wezterm" />
  <package id="oh-my-posh" />

  <!-- Fonts for terminal -->
  <package id="nerd-fonts-Hack" />
  <package id="nerd-fonts-FiraCode" />
  <package id="nerd-fonts-FiraMono" />
  <package id="nerd-fonts-Meslo" />
</packages>
