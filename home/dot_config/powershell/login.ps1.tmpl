# Chezmoi source directory (where dotfiles are managed)
$DOTFILES_DIR = if ($env:XDG_DATA_HOME) {
    Join-Path $env:XDG_DATA_HOME "chezmoi"
} else {
    Join-Path $HOME ".local/share/chezmoi"
}

$Hour = (Get-Date).Hour
$Name = "Jose"
$Theme = "robbyrussell"

If ($Hour -lt 12) {"Good Morning $Name!"}

ElseIf ($Hour -gt 16) {"Good Evening $Name!"}

Else {"Good Afternoon $Name!"; }

# Allow remote execution. Only written when it actually differs - this is a
# registry write, and doing it unconditionally costs time on every shell start.
if (!($IsMacOS) -and (Get-ExecutionPolicy -Scope CurrentUser) -ne 'Bypass') {
    Set-ExecutionPolicy Bypass -Scope CurrentUser -Force -ErrorAction SilentlyContinue;
}

# use tls 1.2
[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072;

# oh-my-posh resolves a bare theme name against its built-in themes. Prefer that
# over $env:POSH_THEMES_PATH: the Chocolatey/MSIX install never sets that
# variable, so the old interpolation produced "/robbyrussel.omp.json" and the
# prompt rendered CONFIG NOT FOUND.
if (Get-Command oh-my-posh -ErrorAction SilentlyContinue) {
    $ThemeArg = $Theme
    if ($env:POSH_THEMES_PATH) {
        $ThemeFile = Join-Path $env:POSH_THEMES_PATH "$Theme.omp.json"
        if (Test-Path $ThemeFile) { $ThemeArg = $ThemeFile }
    }
    oh-my-posh init pwsh --config $ThemeArg | Invoke-Expression
}

# enable AWS command completion
# https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-completion.html
Register-ArgumentCompleter -Native -CommandName aws -ScriptBlock {
    param($commandName, $wordToComplete, $cursorPosition)
        $env:COMP_LINE=$wordToComplete
        if ($env:COMP_LINE.Length -lt $cursorPosition){
            $env:COMP_LINE=$env:COMP_LINE + " "
        }
        $env:COMP_POINT=$cursorPosition
        aws_completer.exe | ForEach-Object {
            [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
        }
        Remove-Item Env:\COMP_LINE
        Remove-Item Env:\COMP_POINT
}

# Check for dotfiles updates - mirrors tools/update.sh on the Zsh side: it asks
# before applying anything, and it asks every time the branch is behind. Never
# applies unasked; this used to run `chezmoi update` inline on every shell start,
# rewriting files mid-session without consent.
#
# Must stay last. -Watch wraps whatever prompt is in effect, and oh-my-posh
# installs its own above. The costly half of the check (the network fetch) is
# deferred to the first prompt render rather than paid here - see update.ps1.
$DotfilesUpdateScript = Join-Path $DOTFILES_DIR "tools/update.ps1"
if (Test-Path $DotfilesUpdateScript) {
    & $DotfilesUpdateScript -Watch
}
